{
  "name": "info-recorder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Word Trail — private audio recording and on-device transcription.",
  "author": "designerzen",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:audio": "vitest run tests/unit/audioUtils.test.ts",
    "test:e2e": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "test:design": "playwright test tests/e2e/design-system.spec.ts",
    "test:all": "vitest run && playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "icons": "node scripts/generate-icons.mjs",
    "desktop:dev": "node scripts/electron-dev.mjs",
    "desktop:prepare": "pnpm build && node scripts/prepare-electron.mjs",
    "desktop:pack": "pnpm desktop:prepare && electron-builder --config electron-builder.cjs --dir --publish never",
    "desktop:build": "pnpm desktop:prepare && electron-builder --config electron-builder.cjs --publish never",
    "test:desktop": "node --test tests/desktop/*.test.cjs",
    "test:desktop:smoke": "node scripts/electron-smoke.mjs",
    "upgrader": "npx npm-check-updates --interactive -u"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^4.3.1",
    "@moonshine-ai/moonshine-wasm": "https://github.com/moonshine-ai/moonshine/releases/download/v0.1.0/moonshine-voice-wasm.tar.gz",
    "@timur00kh/whisper.wasm": "0.1.1",
    "fft.js": "^4.0.4",
    "jassub": "^2.5.23",
    "onnxruntime-web": "^1.30.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.8",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "vitest": "^4.1.9",
    "@testing-library/dom": "^10.4.1"
  }
}
