{
  "name": "info-recorder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:audio": "vitest run tests/unit/audioUtils.test.ts",
    "test:e2e": "playwright test",
    "test:design": "playwright test tests/e2e/design-system.spec.ts",
    "test:all": "vitest run && playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "upgrader": "npx npm-check-updates --interactive -u"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^4.3.1",
    "@moonshine-ai/moonshine-wasm": "https://github.com/moonshine-ai/moonshine/releases/download/v0.1.0/moonshine-voice-wasm.tar.gz",
    "@timur00kh/whisper.wasm": "0.1.1",
    "fft.js": "^4.0.4",
    "jassub": "^2.5.23",
    "lucide-react": "^1.61.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "vitest": "^4.1.9"
  }
}
